# Copy this file to .env and fill it in. .env is never committed to git.

# Claude writes each imported post up as a recipe, and adds tags and macros.
# Get a key at https://console.anthropic.com (Settings → API keys). Leave empty to write recipes up yourself.
ANTHROPIC_API_KEY=

# Which Claude model to use. claude-opus-5-5 is the default; claude-sonnet-5-5 or claude-haiku-5-5 cost less.
CLAUDE_MODEL=claude-opus-5-5

# How Claude writes quantities: metric (g, ml, °C) or us (cups, oz, °F)
UNITS=metric

# Your time zone (for times shown in the app), e.g. Australia/Brisbane, Europe/London, America/New_York
TIMEZONE=UTC

# The port the app is opened on: http://<this computer's IP>:8095
PORT=8095

# The name shown in the app and on the home-screen icon
APP_NAME=Reel Cookbook
