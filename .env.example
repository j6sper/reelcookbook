# Copy this file to .env and fill it in. .env is never committed to git.

# Who the app runs as, so it can write to ./data. The quick start in README.md fills these in:
#   printf 'UID=%s\nGID=%s\n' "$(id -u)" "$(id -g)" >> .env
# UID=1000
# GID=1000

# Your time zone (for times shown in the app), e.g. Australia/Brisbane, Europe/London, America/New_York
TIMEZONE=UTC

# The port the app is opened on: http://<this computer's IP>:8095
PORT=8095

# The name shown in the app and on the home-screen icon
APP_NAME=Reel Cookbook

# Claude is set up in the app (Settings → Claude), with steps for getting a token or key.
# If you'd rather keep them here, these are used until something is saved in the app:
# CLAUDE_CODE_OAUTH_TOKEN=     # from `docker compose exec reelcookbook claude setup-token` (Claude Pro or Max)
# ANTHROPIC_API_KEY=           # from platform.claude.com → API keys (pay as you go)
# CLAUDE_MODEL=claude-opus-5-5 # or claude-sonnet-5-5, claude-haiku-5-5
# UNITS=metric                 # or us
